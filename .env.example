# PAi Environment Variables
# Copy this file to .env and fill in your values

# ── Claude API ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Session ──────────────────────────────────────────────────────────────────
SESSION_SECRET=your_session_secret_here_change_this

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Admin ────────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=otto_admin_2024

# ── Database ─────────────────────────────────────────────────────────────────
# Render auto-populates this from the pai-db service in production
DATABASE_URL=postgresql://user:password@host:5432/pai

# ── OneDataSource (ODS) ──────────────────────────────────────────────────────
ODS_URL=https://bi.onedatasource.com
ODS_ORG=dgi
ODS_USER=hlacoste
ODS_PASSWORD=your_ods_password_here

# ── Velocity Automation ───────────────────────────────────────────────────────
# Shared secret between the cron job and the web service — must match on both
# Render auto-generates this; hardcode locally for manual pulls
VELOCITY_AUTOMATION_TOKEN=022f4a0fa4e2ec99541609c47744d599

# ── Cron / Scripts ───────────────────────────────────────────────────────────
# Base URL the cron job calls — override locally to point at staging or localhost
PAI_BASE_URL=https://pai-ayvaz.onrender.com

# ── GitHub (optional) ────────────────────────────────────────────────────────
# Used by debug scripts to upload output to a Gist
GH_TOKEN=your_github_personal_access_token_here
